-- 1. Tabla de personas
CREATE TABLE persons (
  id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  name TEXT NOT NULL,
  description TEXT DEFAULT '',
  created_at TIMESTAMPTZ DEFAULT NOW(),
  updated_at TIMESTAMPTZ DEFAULT NOW()
);

-- 2. Tabla de imágenes faciales (múltiples por persona)
CREATE TABLE face_images (
  id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  person_id BIGINT NOT NULL REFERENCES persons(id) ON DELETE CASCADE,
  image_url TEXT NOT NULL,
  embedding JSONB NOT NULL,
  confidence FLOAT8 DEFAULT 0.95,
  created_at TIMESTAMPTZ DEFAULT NOW(),
  
  CONSTRAINT fk_person FOREIGN KEY (person_id) REFERENCES persons(id)
);



-- 4. Políticas para desarrollo (permite todo)
CREATE POLICY "Allow all operations on persons" ON persons
  FOR ALL USING (true);

CREATE POLICY "Allow all operations on face_images" ON face_images
  FOR ALL USING (true);

-- 5. Índices para mejor rendimiento
CREATE INDEX idx_face_images_person_id ON face_images(person_id);
CREATE INDEX idx_face_images_created_at ON face_images(created_at DESC);

-- 6. Función para verificar tablas
CREATE OR REPLACE FUNCTION check_tables_exists()
RETURNS BOOLEAN AS $$
BEGIN
  RETURN (
    SELECT EXISTS (SELECT FROM information_schema.tables WHERE table_name = 'persons') AND
           EXISTS (SELECT FROM information_schema.tables WHERE table_name = 'face_images')
  );
END;
$$ LANGUAGE plpgsql;